rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Demo rules for the current static GitHub Pages version.
    // This lets every visitor read and write the shared forum document.
    // For a real public launch, replace this with Firebase Auth-backed rules.
    match /forums/medicapsCommons {
      allow read, write: if true;
    }
  }
}
